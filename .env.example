# preparar.ps1 o preparar.sh copian este archivo a .env y generan las claves vacías.
# .env no se sube a git.

# Claves. Cada instalación usa las suyas.
POSTGRES_PASSWORD=
JWT_SECRET_KEY=
ENGINE_API_KEY=

# Contraseñas de las cuentas de prueba: dueños y vendedores de las dos empresas.
# Solo se aplican al crear las cuentas. Si las cambias después, borra los datos
# con "docker compose down -v" y vuelve a levantar el sistema.
DEMO_OWNER_PASSWORD=
DEMO_SELLER_PASSWORD=

# Puertos de tu máquina. Cámbialos si ya están en uso.
WEB_PORT=3000
API_PORT=8000
ENGINE_PORT=8010
DB_PORT=5433

# Fecha que usa la semilla de PetHouse Miraflores como «hoy», en formato AAAA-MM-DD.
# Vacía: la fecha actual, para que las ventas lleguen hasta ayer.
# Con 2026-11-04 se generan los mismos datos de las capturas del manual.
SEED_HOY=
